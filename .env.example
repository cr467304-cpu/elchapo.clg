# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public Google Maps JavaScript API key (scoped to HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=""

# ADMIN_PASSCODE: Optional server-side passcode override for initial admin access.
ADMIN_PASSCODE=""

# ADMIN_GOOGLE_EMAILS: Optional comma-separated Google emails allowed for /admin Google Sign-In.
ADMIN_GOOGLE_EMAILS=""
